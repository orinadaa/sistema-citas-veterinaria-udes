# Copia este archivo como ".env" (en esta misma carpeta) y llena los valores.
# El archivo .env nunca se sube al repositorio.

# --- Servidor ---
PORT=4000
# En produccion: NODE_ENV=production (activa HTTPS obligatorio y HSTS).
# NODE_ENV=production
# Zona horaria de las citas. Dejarla asi aunque el servidor este en otro pais.
TZ=America/Bogota

# --- Base de datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinica_veterinaria_udes
# En produccion NO usar el usuario "postgres": crear uno propio con permisos
# solo sobre esta base (ver docs/despliegue.md).
DB_USER=postgres
DB_PASSWORD=
# En produccion, si la base esta en otro servidor: DB_SSL=true
# DB_SSL=true

# --- Sesiones ---
# Minimo 32 caracteres. Generar uno nuevo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRACION=8h

# --- Correo (Gmail con contraseña de aplicacion) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# "Contraseña de aplicacion" de Google (no la contraseña normal de la cuenta):
# myaccount.google.com/apppasswords, con verificacion en dos pasos activada.
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=Clínica Veterinaria UDES

# --- Solo produccion ---
# Sitios desde los que el navegador puede llamar a la API (separados por coma).
# CORS_ORIGENES=https://citas.ejemplo.edu.co
# Detras de un proxy (Nginx, plataforma de hosting): 1, para conocer la IP
# real de cada visita y saber si llego por HTTPS.
# TRUST_PROXY=1
# Ruta de pg_dump si no esta en el PATH (copia de seguridad desde Datos).
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
